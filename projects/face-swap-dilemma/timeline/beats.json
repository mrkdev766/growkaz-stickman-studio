[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 3.969,
  "text": "Imagine waking up tomorrow with the face of the most powerful person on earth.",
  "end": 3.85
 },
 {
  "i": 1,
  "start": 3.85,
  "speechStart": 4.0,
  "speechEnd": 7.939,
  "text": "Your reflection is no longer yours.",
  "end": 7.85
 },
 {
  "i": 2,
  "start": 7.85,
  "speechStart": 8.0,
  "speechEnd": 9.928,
  "text": "Your voice is the same.",
  "end": 9.816
 },
 {
  "i": 3,
  "start": 9.816,
  "speechStart": 9.966,
  "speechEnd": 13.753,
  "text": "Your memories are intact, but your face...",
  "end": 13.668
 },
 {
  "i": 4,
  "start": 13.668,
  "speechStart": 13.818,
  "speechEnd": 15.913,
  "text": "completely different.",
  "end": 15.85
 },
 {
  "i": 5,
  "start": 15.85,
  "speechStart": 16.0,
  "speechEnd": 17.97,
  "text": "And here's the terrifying part:",
  "end": 17.85
 },
 {
  "i": 6,
  "start": 17.85,
  "speechStart": 18.0,
  "speechEnd": 21.956,
  "text": "nobody can prove who you really are.",
  "end": 21.85
 },
 {
  "i": 7,
  "start": 21.85,
  "speechStart": 22.0,
  "speechEnd": 25.935,
  "text": "Let's say you discover a strange ability.",
  "end": 25.85
 },
 {
  "i": 8,
  "start": 25.85,
  "speechStart": 26.0,
  "speechEnd": 29.967,
  "text": "With a single thought, you can swap your face with anyone on the planet.",
  "end": 29.85
 },
 {
  "i": 9,
  "start": 29.85,
  "speechStart": 30.0,
  "speechEnd": 31.203,
  "text": "Not a mask.",
  "end": 31.1
 },
 {
  "i": 10,
  "start": 31.1,
  "speechStart": 31.25,
  "speechEnd": 32.913,
  "text": "Not a photograph.",
  "end": 32.85
 },
 {
  "i": 11,
  "start": 32.85,
  "speechStart": 33.0,
  "speechEnd": 35.933,
  "text": "Your actual appearance changes.",
  "end": 35.85
 },
 {
  "i": 12,
  "start": 35.85,
  "speechStart": 36.0,
  "speechEnd": 40.958,
  "text": "You could look like a celebrity, a billionaire, your best friend, or a complete stranger.",
  "end": 40.85
 },
 {
  "i": 13,
  "start": 40.85,
  "speechStart": 41.0,
  "speechEnd": 44.928,
  "text": "At first, it sounds like the ultimate superpower.",
  "end": 44.85
 },
 {
  "i": 14,
  "start": 44.85,
  "speechStart": 45.0,
  "speechEnd": 47.981,
  "text": "But let's see what happens when you actually use it.",
  "end": 47.85
 },
 {
  "i": 15,
  "start": 47.85,
  "speechStart": 48.0,
  "speechEnd": 50.905,
  "text": "On day one, you experiment.",
  "end": 50.85
 },
 {
  "i": 16,
  "start": 50.85,
  "speechStart": 51.0,
  "speechEnd": 53.968,
  "text": "You walk into a café looking like a famous actor.",
  "end": 53.85
 },
 {
  "i": 17,
  "start": 53.85,
  "speechStart": 54.0,
  "speechEnd": 55.954,
  "text": "People recognize the face instantly.",
  "end": 55.85
 },
 {
  "i": 18,
  "start": 55.85,
  "speechStart": 56.0,
  "speechEnd": 59.935,
  "text": "They stare, whisper, and ask for selfies.",
  "end": 59.85
 },
 {
  "i": 19,
  "start": 59.85,
  "speechStart": 60.0,
  "speechEnd": 63.948,
  "text": "For the first time, strangers treat you like someone important.",
  "end": 63.85
 },
 {
  "i": 20,
  "start": 63.85,
  "speechStart": 64.0,
  "speechEnd": 65.957,
  "text": "Then you change back.",
  "end": 65.85
 },
 {
  "i": 21,
  "start": 65.85,
  "speechStart": 66.0,
  "speechEnd": 68.949,
  "text": "Suddenly, you're invisible again.",
  "end": 68.85
 },
 {
  "i": 22,
  "start": 68.85,
  "speechStart": 69.0,
  "speechEnd": 71.917,
  "text": "And you realize something uncomfortable.",
  "end": 71.85
 },
 {
  "i": 23,
  "start": 71.85,
  "speechStart": 72.0,
  "speechEnd": 74.98,
  "text": "People haven't changed their behavior because of who you are,",
  "end": 74.85
 },
 {
  "i": 24,
  "start": 74.85,
  "speechStart": 75.0,
  "speechEnd": 78.937,
  "text": "they've changed it because of what your face represents.",
  "end": 78.85
 },
 {
  "i": 25,
  "start": 78.85,
  "speechStart": 79.0,
  "speechEnd": 81.92,
  "text": "But that's only the beginning.",
  "end": 81.85
 },
 {
  "i": 26,
  "start": 81.85,
  "speechStart": 82.0,
  "speechEnd": 84.948,
  "text": "You decide to test something more personal.",
  "end": 84.85
 },
 {
  "i": 27,
  "start": 84.85,
  "speechStart": 85.0,
  "speechEnd": 87.965,
  "text": "You swap faces with someone your family knows.",
  "end": 87.85
 },
 {
  "i": 28,
  "start": 87.85,
  "speechStart": 88.0,
  "speechEnd": 89.978,
  "text": "Then you walk through your own front door.",
  "end": 89.85
 },
 {
  "i": 29,
  "start": 89.85,
  "speechStart": 90.0,
  "speechEnd": 92.922,
  "text": "Your mother sees a stranger.",
  "end": 92.85
 },
 {
  "i": 30,
  "start": 92.85,
  "speechStart": 93.0,
  "speechEnd": 95.969,
  "text": "Your best friend doesn't recognize you.",
  "end": 95.85
 },
 {
  "i": 31,
  "start": 95.85,
  "speechStart": 96.0,
  "speechEnd": 99.969,
  "text": "Your partner steps back, wondering who just entered the room.",
  "end": 99.85
 },
 {
  "i": 32,
  "start": 99.85,
  "speechStart": 100.0,
  "speechEnd": 105.949,
  "text": "You know their birthdays, their secrets, the memories nobody else shares.",
  "end": 105.85
 },
 {
  "i": 33,
  "start": 105.85,
  "speechStart": 106.0,
  "speechEnd": 109.737,
  "text": "But to them, you're an unfamiliar face,",
  "end": 109.632
 },
 {
  "i": 34,
  "start": 109.632,
  "speechStart": 109.782,
  "speechEnd": 112.955,
  "text": "claiming to be someone they love.",
  "end": 112.85
 },
 {
  "i": 35,
  "start": 112.85,
  "speechStart": 113.0,
  "speechEnd": 114.944,
  "text": "You could tell them everything.",
  "end": 114.85
 },
 {
  "i": 36,
  "start": 114.85,
  "speechStart": 115.0,
  "speechEnd": 117.949,
  "text": "Would they believe you?",
  "end": 117.85
 },
 {
  "i": 37,
  "start": 117.85,
  "speechStart": 118.0,
  "speechEnd": 121.959,
  "text": "Now imagine the consequences outside your home.",
  "end": 121.85
 },
 {
  "i": 38,
  "start": 121.85,
  "speechStart": 122.0,
  "speechEnd": 123.973,
  "text": "Your phone unlocks with your face.",
  "end": 123.85
 },
 {
  "i": 39,
  "start": 123.85,
  "speechStart": 124.0,
  "speechEnd": 125.971,
  "text": "Security cameras record you.",
  "end": 125.85
 },
 {
  "i": 40,
  "start": 125.85,
  "speechStart": 126.0,
  "speechEnd": 128.927,
  "text": "People identify you through photographs.",
  "end": 128.85
 },
 {
  "i": 41,
  "start": 128.85,
  "speechStart": 129.0,
  "speechEnd": 133.949,
  "text": "But what happens when your face no longer matches your official identity?",
  "end": 133.85
 },
 {
  "i": 42,
  "start": 133.85,
  "speechStart": 134.0,
  "speechEnd": 135.973,
  "text": "Some systems might reject you.",
  "end": 135.85
 },
 {
  "i": 43,
  "start": 135.85,
  "speechStart": 136.0,
  "speechEnd": 138.966,
  "text": "Others might mistake you for someone else.",
  "end": 138.85
 },
 {
  "i": 44,
  "start": 138.85,
  "speechStart": 139.0,
  "speechEnd": 141.975,
  "text": "And if someone commits a crime while wearing your face,",
  "end": 141.85
 },
 {
  "i": 45,
  "start": 141.85,
  "speechStart": 142.0,
  "speechEnd": 145.94,
  "text": "how do you prove you weren't there?",
  "end": 145.85
 },
 {
  "i": 46,
  "start": 145.85,
  "speechStart": 146.0,
  "speechEnd": 149.92,
  "text": "In a world built around recognizing appearances,",
  "end": 149.85
 },
 {
  "i": 47,
  "start": 149.85,
  "speechStart": 150.0,
  "speechEnd": 152.94,
  "text": "your greatest power becomes your greatest vulnerability.",
  "end": 152.85
 },
 {
  "i": 48,
  "start": 152.85,
  "speechStart": 153.0,
  "speechEnd": 156.938,
  "text": "Now imagine discovering something even more dangerous.",
  "end": 156.85
 },
 {
  "i": 49,
  "start": 156.85,
  "speechStart": 157.0,
  "speechEnd": 159.955,
  "text": "You can become someone people trust.",
  "end": 159.85
 },
 {
  "i": 50,
  "start": 159.85,
  "speechStart": 160.0,
  "speechEnd": 162.042,
  "text": "Someone with influence.",
  "end": 161.968
 },
 {
  "i": 51,
  "start": 161.968,
  "speechStart": 162.118,
  "speechEnd": 163.944,
  "text": "Someone with access.",
  "end": 163.85
 },
 {
  "i": 52,
  "start": 163.85,
  "speechStart": 164.0,
  "speechEnd": 167.963,
  "text": "Someone whose face opens doors that would otherwise remain closed.",
  "end": 167.85
 },
 {
  "i": 53,
  "start": 167.85,
  "speechStart": 168.0,
  "speechEnd": 170.963,
  "text": "But every time you use that power to deceive someone,",
  "end": 170.85
 },
 {
  "i": 54,
  "start": 170.85,
  "speechStart": 171.0,
  "speechEnd": 175.937,
  "text": "you risk destroying the very thing that makes relationships meaningful.",
  "end": 175.85
 },
 {
  "i": 55,
  "start": 175.85,
  "speechStart": 176.0,
  "speechEnd": 178.76,
  "text": "Trust.",
  "end": 178.85
 },
 {
  "i": 56,
  "start": 178.85,
  "speechStart": 179.0,
  "speechEnd": 181.965,
  "text": "And then comes the question you never expected to ask yourself.",
  "end": 181.85
 },
 {
  "i": 57,
  "start": 181.85,
  "speechStart": 182.0,
  "speechEnd": 184.93,
  "text": "If you can become anyone,",
  "end": 184.85
 },
 {
  "i": 58,
  "start": 184.85,
  "speechStart": 185.0,
  "speechEnd": 190.976,
  "text": "how long before you stop knowing who you are? Here's the real twist.",
  "end": 190.85
 },
 {
  "i": 59,
  "start": 190.85,
  "speechStart": 191.0,
  "speechEnd": 196.92,
  "text": "The most valuable thing about your face was never your appearance.",
  "end": 196.85
 },
 {
  "i": 60,
  "start": 196.85,
  "speechStart": 197.0,
  "speechEnd": 199.978,
  "text": "It was the connection people built around it.",
  "end": 199.85
 },
 {
  "i": 61,
  "start": 199.85,
  "speechStart": 200.0,
  "speechEnd": 204.97,
  "text": "Your face was how your family recognized you, how friends remembered you,",
  "end": 204.85
 },
 {
  "i": 62,
  "start": 204.85,
  "speechStart": 205.0,
  "speechEnd": 208.967,
  "text": "and how strangers began to trust or distrust you.",
  "end": 208.85
 },
 {
  "i": 63,
  "start": 208.85,
  "speechStart": 209.0,
  "speechEnd": 212.975,
  "text": "Change that face, and you might change how the world treats you,",
  "end": 212.85
 },
 {
  "i": 64,
  "start": 212.85,
  "speechStart": 213.0,
  "speechEnd": 215.954,
  "text": "but you don't automatically change your memories,",
  "end": 215.85
 },
 {
  "i": 65,
  "start": 215.85,
  "speechStart": 216.0,
  "speechEnd": 220.928,
  "text": "your choices, or the person you've become.",
  "end": 220.85
 },
 {
  "i": 66,
  "start": 220.85,
  "speechStart": 221.0,
  "speechEnd": 224.954,
  "text": "And if nobody can recognize you anymore, you'll discover something terrifying:",
  "end": 224.85
 },
 {
  "i": 67,
  "start": 224.85,
  "speechStart": 225.0,
  "speechEnd": 228.958,
  "text": "being known and being seen are not the same thing.",
  "end": 228.85
 },
 {
  "i": 68,
  "start": 228.85,
  "speechStart": 229.0,
  "speechEnd": 233.96,
  "text": "So if you could swap faces with anyone on earth for just 24 hours,",
  "end": 233.85
 },
 {
  "i": 69,
  "start": 233.85,
  "speechStart": 234.0,
  "speechEnd": 235.945,
  "text": "who would you choose?",
  "end": 235.85
 },
 {
  "i": 70,
  "start": 235.85,
  "speechStart": 236.0,
  "speechEnd": 241.964,
  "text": "And more importantly, would you use that power to experience another life,",
  "end": 241.85
 },
 {
  "i": 71,
  "start": 241.85,
  "speechStart": 242.0,
  "speechEnd": 246.914,
  "text": "or to escape your own?",
  "end": 246.85
 },
 {
  "i": 72,
  "start": 246.85,
  "speechStart": 247.0,
  "speechEnd": 251.968,
  "text": "Tell me in the comments, because the next time you look in a mirror, remember this:",
  "end": 251.85
 },
 {
  "i": 73,
  "start": 251.85,
  "speechStart": 252.0,
  "speechEnd": 257.608,
  "text": "your face might be what the world sees first, but it isn't everything you are.",
  "end": 259.108
 }
]